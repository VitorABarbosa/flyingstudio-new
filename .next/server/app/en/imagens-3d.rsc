12:["$","$L20",null,{"formats":"$undefined","locale":"en","messages":{"Home":{"hero":{"eyebrow":"Where imagination gets an address","titleLine":"Far beyond","titleWord":"perspectives","support":"For 15 years we have turned real-estate developments into images, films and immersive experiences that sell before the first brick.","ctaPrimary":"Explore services","ctaSecondary":"Talk to the studio","metaLocation":"São Paulo — Brazil","metaSince":"Since 2010","metaMarket":"Real estate market","scrollCue":"Scroll to explore","tagline":"Far beyond perspectives"},"dsbrave":{"eyebrow":"Our own product","title":"Meet D.sbrave","subtitle":"An immersive experience inside the development","cta":"Discover D.sbrave","demoLabel":"Live demo","demoHint":"Enable interactive mode","demoActive":"Interactive mode on — drag to explore","views":{"loteamento":"Masterplan","predio":"Tower"}},"partners":{"title":"Much more than clients","subtitle":"Partners, friends and a true family."},"cta":{"titleStart":"Take the next","titleAccent":"step","primary":"Start a project","whatsapp":"Chat on WhatsApp","emailLabel":"or write to"},"grupo":{"eyebrow":"Our Group","titleStart":"One essence,","titleAccent":"four perspectives","narrative":"A great launch demands mastery on multiple fronts — and that is how the Flying Group works: specialized companies operating in perfect synergy, from vocation analysis and product development to design, film and launch technology. When every front speaks the same language, the result translates into speed, coherence and conversion.","cta":"Meet the group from the inside","visitLabel":"Visit the website","visitFlying":"Discover our DNA","companies":{"flying":{"name":"Flying Studio","slogan":"Far beyond perspectives.","role":"Launch ecosystem","desc":"We orchestrate a technological arsenal designed to enchant, immerse and sell — imagery, apps, 360º immersion, films and experiences that make tomorrow tangible."},"rinno":{"name":"Rinno Films","slogan":"Your project deserves cinema.","role":"Audiovisual production","desc":"The narrative that sells: concept, product, viral and documentary films."},"nid":{"name":"NID Studio","slogan":"Your creative nest.","role":"Strategic design","desc":"The architecture of desire: interiors, facades, sales stands and show units."},"ogdi":{"name":"Open Group","slogan":"Value is born before the build.","role":"Real-estate development","desc":"From opportunity to launch: structuring, feasibility, product development and launch."}}}},"Hero":{"headline":"Artistic 3D Technology","titleStart":"We make tomorrow","titleAccent":"felt.","subtitle":"From the first image to the decision to buy","label":"EXPERTS IN THE REAL ESTATE MARKET","tagline":"Much beyond perspectives","cards":{"images":{"title":"High-Impact\nImages","description":"The first impression that defines the sale. Aesthetic rigor, light, framing and humanization to capture the <b>essence of the project</b> and spark <b>immediate desire</b>.","cta":"Learn more"},"video":{"title":"Strategic\nFilms","description":"We don't make videos: we tell the development's story in a magnetic way. Concept, product, viral and documentary films that <b>turn square meters into life stories</b>.","cta":"Learn more"},"tech":{"title":"Commercial\nApps","description":"Absolute control of the narrative. Content in layers and logical sequences creates a <b>path of persuasion</b> that guides the decision step by step, <b>whoever is presenting</b>.","cta":"Learn more"},"tour":{"title":"Virtual Tour\n360º","description":"The hyper-realistic experience: the client explores every space from every angle, <b>making it tangible</b> and <b>removing objections to buying</b>.","cta":"Learn more"},"dsbrave":{"title":"Discover\nD.sbrave","description":"The 360º time machine. The buyer <b>walks through their future home</b> with full autonomy and starts creating their stories right there.","cta":"Learn more"}}},"Sobre":{"label":"FLYING STUDIO","intro":"On 9 May 2011 we opened our doors with a simple, powerful belief: a picture is worth more than a thousand words. Since then we have been the bridge between the idea and the sale, giving shape to the buyer’s dream before the first brick is laid.","years":"We were born to give shape to the invisible.","description":"Art will always be our compass, but the journey brought us something even more valuable: market precision. We have followed the birth of hundreds of developments and we understand what makes a project sell.","cta":"Meet Flying Studio"},"ServiceBridge":{"images3d":{"question":"Emotion grows in motion.","action":"Discover the Films"},"videos3d":{"question":"Now, the development in the broker's hands.","action":"Discover the Apps"},"apps":{"question":"The next step is walking inside the project.","action":"Explore the 360° Virtual Tour"},"tour360":{"question":"All of it, together in one place.","action":"Discover D.sbrave"},"dsbrave":{"question":"It all starts with a great image.","action":"See the 3D Images"}},"Nav":{"services":"Services","portfolio":"Portfolio","about":"About","contact":"Contact","languageSwitcher":"PT"},"Header":{"navLabel":"Main menu","openMenu":"Open menu","nav":{"home":"Home","about":"About Us","services":"Services","cases":"Our Group","join":"Join Us","news":"Flying News"},"services":{"images3d":"Images","videos3d":"Films","apps":"Applications","dsbrave":"D.sbrave","tour360":"Virtual Tour 360º"},"contact":"Contact","closeMenu":"Close menu","switchLanguageLabel":"Switch to {language}"},"DSbrave":{"label":"MANAGEMENT","title":"Meet D.sbrave","subtitle":"Intelligent management for high-performance projects","description":"We create 3D Images with exclusive technology for high-standard architectural visualization.","cta":"Discover D.sbrave"},"DSbravePage":{"hero":{"home":"Home","eyebrow":"Service"},"explainer":{"eyebrow":"WHAT IS","title":"The future in the palm of the hand.","description":"Flying's exclusive 360º immersion app: full autonomy for the buyer to walk through their future home, explore every space from every angle and start creating their stories right there. And it doesn't stop at the sale — from the first render to construction tracking, the whole operation works in one place."},"module":{"prevLabel":"Previous modules","nextLabel":"Next modules","items":{"splitview":{"title":"Split View","description":"Real-time construction progress, side by side with the project."},"lotes":{"title":"Lot Automation","description":"Reservations and availability updated instantly."},"mapa":{"title":"Interactive Surroundings Map","description":"360° aerial drone view with pins for other developments and direct integration with their websites."},"exploracao":{"title":"360° Exploration","description":"High-quality environments explored right inside the hub."},"unify":{"title":"Unifies the tours","description":"Brings the project's virtual environments together in a single access hub."},"guide":{"title":"Guides the visit","description":"Helps users understand the development as a journey, not scattered content."},"desire":{"title":"Builds desire","description":"Brings the client closer to the routine, the spaces and the feeling of a future home."},"standalone":{"title":"Standalone module","description":"An independent experience for campaigns, launches and sales presentations."},"app":{"title":"Inside the app","description":"It can also be embedded in the development's app as an immersive area."}}},"projects":{"eyebrow":"WHO ALREADY USES IT","title":"Projects with D.sbrave","prevLabel":"Previous projects","nextLabel":"Next projects"},"demo":{"headline":"See D.sbrave in action.","button":"Request a demo"}},"Images3DPage":{"hero":{"home":"Home","eyebrow":"Service","title":"Images"},"sections":{"geral":{"title":"General","description":"Get to know some of our projects."},"loteamentos":{"title":"Land Developments","description":"Projects focused on presenting leisure areas, landscaping, and outdoor visual experiences."},"fachadas":{"title":"Facades","description":"Facade and volumetry studies that highlight the development's architectural concept."},"plantas-humanizadas":{"title":"Furnished Floor Plans","description":"Representations designed to clearly communicate layout, circulation, and use of space."},"internas":{"title":"Interiors","description":"Interior perspectives created to convey atmosphere, finishes, lighting, and the experience of living."},"externas":{"title":"Exteriors","description":"Exterior perspectives created to convey atmosphere, finishes, lighting, and the experience of living."}},"seeMoreLabel":"See more","lightbox":{"previous":"Previous image","next":"Next image","close":"Close"},"ctaHeadline":"Let's give shape to your development.","ctaLabel":"I want my perspectives"},"Videos3DPage":{"hero":{"home":"Home","eyebrow":"Service","title":"Films"},"tabs":{"todos":"All","conceitos":"Concepts","produtos":"Products","virais":"Virals"},"sections":{"conceitos":{"title":"Concepts","description":"Concept films focused on lifestyle and brand positioning, connecting the development to the buyer's emotions."},"produtos":{"title":"Products","description":"A deep dive into architecture, infrastructure, and technical differentiators, showcasing every square meter of the development."},"virais":{"title":"Virals","description":"Short, dynamic 9:16 formats optimized for social media engagement and paid traffic campaigns."}},"carousel":{"prevLabel":"Previous in section {title}","nextLabel":"Next in section {title}","pageLabel":"Go to page {page}","closeLabel":"Close video","openLabel":"Open video {title}","expandLabel":"Expand video {title}","seeMoreRinno":"See more at Rinno Films"},"rinno":{"eyebrow":"Rinno Films · Flying Group","leadQuestion":"Looking for documentaries and institutional films?","leadAnswer":"They're by <rinno>Rinno Films</rinno> — the same production company behind every film on this page.","titlePre":"This is where","titleAccent":"real estate cinema begins.","description":"The group's production company treats every development as a screenplay: documentaries that preserve the first creative spark, concept and product films that awaken desire, and viral narratives that take over the feeds.","cta":"Visit Rinno Films"}},"AplicativosPage":{"hero":{"home":"Home","eyebrow":"Service","title":"Apps"},"explainer":{"eyebrow":"WHAT IS THE APP","title":"Control of the presentation.","description":"Absolute control of the commercial narrative. Interactive applications that bring the whole development together — renders, films, floor plans and 360º tours in one place — and go further: the content is structured in layers and logical sequences, creating a path of persuasion that guides the client's decision step by step."},"benefits":{"prevLabel":"Previous highlights","nextLabel":"Next highlights","items":{"sob-medida":{"title":"Tailor-made design","description":"Each application is unique to the developer, reinforcing the project's brand."},"multiplataforma":{"title":"Any device","description":"Accessible on any device, no installation required."},"a-prova-de-falhas":{"title":"Failure-proof","description":"The scale and persuasive power of the project keep their full force, whoever is running the presentation."},"corretor":{"title":"In the broker's hands","description":"At the sales stand or wherever the sale happens, the broker leads the presentation and answers on the spot: floor plan, masterplan, view from the unit."}}},"projects":{"eyebrow":"APPLICATION SOLUTIONS","title":"Custom Projects","prevLabel":"Previous projects","nextLabel":"Next projects"},"demo":{"headline":"See the App in action.","button":"Request a demo"}},"Tour360Page":{"hero":{"home":"Home","eyebrow":"Service","title":"360° Virtual Tour"},"explainer":{"eyebrow":"WHAT IS THE VIRTUAL TOUR","title":"The end of objections.","description":"A hyper-realistic 360º experience: the client explores every detail, from every angle and in every space, making it tangible long before the first brick. What the floor plan doesn't explain and the image doesn't answer, the tour resolves — on any screen, through a link."},"benefits":{"prevLabel":"Previous highlights","nextLabel":"Next highlights","items":{"1":{"title":"Your Immersive Product","description":"Your virtual tour is presented with more context and perceived value for the client."},"2":{"title":"Personalized Experience","description":"Each tour can be tailored to reinforce the development's experience and purpose."},"3":{"title":"Multiple Interactions","description":"Add clickable points, relevant information, and guided navigation within the space."},"4":{"title":"Your Product In a New World","description":"An innovative way to present your product in a memorable, interactive manner."}}},"projects":{"eyebrow":"360° VIRTUAL TOUR SOLUTIONS","title":"Get to Know Our Projects","prevLabel":"Previous projects","nextLabel":"Next projects"},"demo":{"headline":"See the Virtual Tour in action.","button":"Request a demo"}},"DnaPage":{"hero":{"metaSince":"Since 2011","metaPlace":"São Paulo — Brazil","subtitle":"Get to know our essence at the root.","description":"On May 9, 2011, we opened our doors with a simple, powerful belief: an image is worth more than a thousand words. Everything we are was born from that belief.","scrollLabel":"Go to our history"},"historia":{"eyebrow":"OUR","title":"History","foundedLabel":"Since May 9, 2011","description":"For years we were the bridge between the idea and the sale, virtually materializing the buyer's dream before the first brick was laid. We proved that our art is not just about illustrating reality — it is about making clients experience the future. Far beyond perspectives has always been our motto and, secretly, our prophecy.","description2":"Over almost two decades, while illustrating tomorrow for the market's biggest players, we absorbed the intelligence behind every success and the wisdom behind every failure. We followed the birth of hundreds of developments and came to understand what makes a project sell: what draws the investor's eye, what accelerates a launch, and what turns a plot of land into a true case of success and desire.","imageAlt1":"Flying Studio team at the office","imageAlt2":"Flying Studio studio space","imageAlt3":"'An image is worth a thousand words' mural at the office","prevLabel":"Previous slide","nextLabel":"Next slide"},"essencia":{"titlePre":"What it means to be","prevLabel":"Previous slide","nextLabel":"Next slide","slides":{"cultura":{"eyebrow":"OUR","title":"Culture","description":"Our culture is built on the union of strategy, creativity and collaboration to deliver high-value solutions. We operate with market precision, using intelligence and market knowledge to guide our decisions. We value agility in execution without compromising quality, and we believe in a unified ecosystem where clear communication and integration between teams eliminate noise and provide a consistent experience for clients and staff."},"proposito":{"eyebrow":"OUR","title":"Purpose","description":"A flawless image is the perfect invitation, but our goal became bigger: taking control of the entire buying experience. We designed an ecosystem where technology is an invitation to enchantment — and visual attraction is only the first act of a great spectacle of conversion."},"manifesto":{"eyebrow":"OUR","title":"Manifesto","description":"We were born to give shape to the invisible. We don't deliver mere products: we orchestrate a technological arsenal designed to enchant, immerse and sell — imagery, apps, 360º immersion, films and experiences that make tomorrow tangible."}},"pilares":{"missao":{"title":"Mission","description":"To materialize the future before construction, transforming projects into experiences that inspire confidence, awaken desire and accelerate purchase decisions."},"visao":{"title":"Vision","description":"To consolidate the largest brand experience ecosystem in Latin America and expand our international presence, becoming a global reference in innovation, excellence and the transformation of projects into high-impact experiences."},"valores":{"title":"Values","description":"Aesthetic rigor in every detail, intelligence in every decision and total synergy between creation, technology and strategy — so a project's grandeur is never lost along the way."}}},"statement":{"headline":"We don't just display tomorrow — we make it felt.","complement":"If one image speaks louder than a thousand words, imagine the power of an entire digital universe conspiring in favor of your next big launch."},"qg":{"eyebrow":"OUR HQ","title":"The epicenter of real estate technology","address":"Av. Engenheiro Luís Carlos Berrini — Itaim Bibi, São Paulo, SP","description":"More than a studio: an innovation lab where creative minds, technology developers, and launch strategists work in full synergy. Wherever your development is being born, it is from here that we orchestrate the visual and technological intelligence that will make it dominate the market."},"vozes":{"eyebrow":"VOICES OF THE DNA","title":"Those who live Flying, tell it","description":"Five questions, dozens of real stories. Scroll the line and dive into what turns a job into belonging.","playLabel":"Watch testimonial","closing":"It's never too early and never too late to start. That's the line connecting every story here — and it's still being written.","ctaLabel":"Watch the full video","items":{"transformacao":{"eyebrow":"TRANSFORMATION","question":"What would your past self be most surprised to learn about who you are today?","quote":"You took too long to accept this challenge."},"pertencimento":{"eyebrow":"BELONGING","question":"What makes Flying different from anywhere else you've worked?","quote":"There is no ceiling for growth here. It's brotherhood."},"pluralidade":{"eyebrow":"PLURALITY","question":"In practice, what does 'never too early, never too late to start' mean?","quote":"From Pablo's 15 years to Enrique's 48 — the same hunger to learn."},"impacto":{"eyebrow":"REAL IMPACT","question":"How does it feel to see a project of yours materialized on the street?","quote":"'My husband made that' — the 3D that becomes a family's dream."},"proposito":{"eyebrow":"PURPOSE","question":"Why is the overflow of knowledge Flying's main pillar?","quote":"The company is just a formality for people to connect."}}},"grupo":{"titlePre":"Our","titleAccent":"Group","description":"A great launch demands mastery on multiple fronts. The Flying Group gathers specialized companies operating in perfect synergy — from product design to launch technology. When every front speaks the same language, the result is speed, coherence, and conversion.","visitLabel":"Visit website","openLabel":"View details","closeLabel":"Close","companies":{"flying":{"name":"Flying Studio","role":"Artistic 3D technology","description":"The group's parent company: images, applications, tours, and immersive experiences for real estate launches.","services":["3D Images","Applications","D.sbrave","360º Tour"]},"rinno":{"name":"Rinno Films","role":"Film production","description":"The narrative that sells: concept, product, viral, and documentary films for the real estate market.","services":["Concept Film","Product Film","Viral Film","DOC Film"]},"nid":{"name":"NID Studio","role":"Strategic design","description":"The architecture of desire: interior design, facades, sales stands, and decorated model apartments.","services":["Sales Stand","Model Apartment","Facades","Interiors"]},"ogdi":{"name":"Open Group Real Estate Development","role":"Real Estate Structuring & Development","description":"Turns real estate opportunities into ventures ready to move forward: from concept to launch, with feasibility, partners, and vision from the origin.","services":["Structuring","Feasibility","Real Estate Product","Launch"]}},"cta":"Meet the group from the inside"},"parceiros":{"titlePre":"Much more than clients,","titleHighlight":"partners."}},"NossoGrupo":{"title":"Meet","titleHighlight":"Our Group","subtitle":"Get to know the group behind this experience and discover what drives us","cards":{"card1":{"name":"Cosmopolitan","description":"OXE ENGENHARIA"},"card2":{"name":"The One Saúde","description":"OUSY"},"card3":{"name":"G3 Move","description":"GREMP3"},"card4":{"name":"Vita Vila Prudente","description":"ENGECASTRO"},"card5":{"name":"Livigno","description":"TAVARES E ROSSETI"}}},"Footer":{"phone":"(11) 2351-4138","email":"studio@flyingstudio.com.br","address":"Av. Engenheiro Luís Carlos Berrini — Itaim Bibi, São Paulo, SP","ariaLabel":"Flying Studio on {name}"},"Contato":{"hero":{"home":"Home","label":"Contact","bannerAlt":"The Flying Studio office","ariaHeading":"Let's start a project together.","words":{"w1":"Shall we","w2":"start","w3":"a","w4":"project","w5":"together."}},"form":{"title":"Fill in your details","fields":{"company":{"label":"Company Name"},"email":{"label":"E-mail"},"whatsapp":{"label":"Whatsapp"},"responsible":{"label":"Contact"},"subject":{"label":"What do you need?","placeholder":"Select a subject","options":{"imagens":"3D Images","filmes":"3D Films","aplicativos":"Apps","tour":"Virtual Tour 360º","dsbrave":"D.sbrave","lancamento":"A complete launch","outro":"Something else"}}},"privacyPrefix":"I accept the","privacyLink":"Privacy Policy","submit":"I'm Ready","submitted":"Sent!","sending":"Sending...","error":"The submission failed just now. Try again in a moment or reach us on WhatsApp."},"meeting":{"title":"Every launch starts with","titleHighlight":"a conversation.","text":"A Flying specialist gets your project and answers on WhatsApp.","cta":"Talk to a specialist"}},"JunteSeANos":{"hero":{"home":"Home","label":"Join Us","title":"Be Flying Studio","bannerAlt":"The Flying Studio team working at the studio"},"bancoTalentos":{"label":"Talent Pool","titleLine1":"Join","titleLine2":"us","paragraph":"Our HQ on Berrini is more than a studio: it's a laboratory where creative minds, technology developers and launch strategists work in the same room. Everything we make is born from that synergy — and those are the people we are always looking for.","closing":"Let's build something extraordinary together!","fields":{"name":{"label":"Full Name"},"area":{"label":"Desired area:","placeholder":"Select"},"email":{"label":"E-mail"},"whatsapp":{"label":"Whatsapp"}},"areas":{"administrativo":"Administrative","arte":"Art & Creation","tecnologia":"Technology","arquitetura":"Architecture","other":"Others"},"uploadTitle":"Add your résumé here","uploadHint":"drag the file or click the area","submit":"Submit Résumé","submitted":"Résumé sent!","sending":"Sending...","error":"The submission failed just now. Try again in a moment."}},"Metadata":{"title":"Flying Studio — Far Beyond Perspectives","description":"For 15 years we have turned real estate launches into experiences: 3D renderings, films, sales apps, 360º virtual tours and immersion that sell before construction.","keywords":"3D renderings, architectural visualization, real estate 3D images, real estate films, sales app, 360º virtual tour, real estate launch","ogImageAlt":"Flying Studio — artistic 3D technology for real estate launches","pages":{"dna-flying-studio":{"title":"About Us","description":"Discover the history, culture and ecosystem of the Flying Group: 15 years giving shape to the invisible for the market's biggest real estate launches."},"imagens-3d":{"title":"3D Images & Renderings","description":"Hyper-realistic 3D renderings of facades, shared amenities, interiors and floor plans — images that sell the development before construction."},"videos-3d":{"title":"Real Estate Films","description":"Concept, product and viral films produced by Rinno Films: real estate cinema that turns square meters into life narratives."},"aplicativos":{"title":"Sales App","description":"The sales app that centralizes the entire launch — renders, films, floor plans and 360º tours — in a persuasion path that guides the client's decision."},"tour-virtual-360":{"title":"360º Virtual Tour","description":"The hyper-realistic experience of the development: clients explore every space from every angle, eliminating objections before the first brick."},"dsbrave":{"title":"D.sbrave — 360º Immersion","description":"The 360º time machine: buyers walk through their future home with full autonomy, from the sales stand or any screen."},"cases":{"title":"Our Group & Cases","description":"The Flying Group ecosystem in action: OGDI, NID, Flying Studio and Rinno Films signing complete launches, from concept to sale."},"contato":{"title":"Contact","description":"Talk to Flying Studio and let's shape your next real estate launch — images, films, sales app and 360º immersion."},"junte-se-a-nos":{"title":"Join Us","description":"Work at the Flying Group: send your résumé to the talent pool of our HQ on Berrini, São Paulo."},"flying-news":{"title":"Flying News","description":"News, behind the scenes and launches from the Flying Studio universe."}}},"Sidebar":{"ariaLabel":"Main sidebar menu","close":"Close menu","languageLabel":"Switch to {locale}","ctaTitle":"Let's start a project together.","ctaButton":"Request Quote","links":{"home":"Home","dna":"Flying Studio DNA","images3d":"3D Images","videos3d":"3D Videos","apps":"Applications","tour360":"Virtual Tour 360º","dsbrave":"D.sbrave","join":"Join Us","news":"Flying News","cases":"Our Group","contact":"Contact"}},"FlyingNews":{"hero":{"title":"Flying News","tagline":"The Studio that changes your perspective","categories":{"market":{"title":"News & Market","description":"Real estate news and market insights"},"innovation":{"title":"Innovation & Trends","description":"What's new in innovation!"}}},"highlights":{"eyebrow":"HIGHLIGHTS","title":"Flying News","articleDate":"São Paulo, 04.02.2026","articleExcerpt":"Lorem Ipsum is simply dummy text of the printing and typesetting industry.","readMore":"Continue Reading","allEditions":"View All Editions","articles":{"entrada-residencial":{"title":"Lorem Ipsum is simply dummy text of the printing...","imageAlt":"Residential development entrance"},"area-comercial":{"title":"Lorem Ipsum is simply dummy text of the printing.","imageAlt":"Contemporary commercial area"},"fachada-residencial":{"title":"Lorem Ipsum is simply dummy text of the printing...","imageAlt":"Residential development facade"},"area-de-lazer":{"title":"Lorem Ipsum is simply dummy text.","imageAlt":"Leisure area with swimming pool"}}},"market":{"title":"News & Market","subtitle":"REAL ESTATE NEWS AND MARKET INSIGHTS","articleTitle":"Lorem Ipsum is simply dummy text of the printing and typesetting industry.","articleDate":"São Paulo, 04.02.2026","articleExcerpt":"Lorem Ipsum is simply dummy text of the printing and typesetting industry.","readMore":"Continue Reading","previous":"Previous page","next":"Next page","pageLabel":"Go to page"},"innovation":{"title":"Innovation & Trends","subtitle":"WHAT'S NEW IN INNOVATION?","articleTitle":"Lorem Ipsum is simply dummy text of the printing and typesetting industry.","articleDate":"São Paulo, 04.02.2026","articleExcerpt":"Lorem Ipsum is simply dummy text of the printing and typesetting industry.","readMore":"Continue Reading","previous":"Previous innovation page","next":"Next innovation page","pageLabel":"Go to innovation page"}},"CasesPage":{"hero":{"home":"Home","label":"Our Group","title":"<strong>One</strong> <light>project</light><br></br><strong>four</strong> <light>perspectives</light><strong>,</strong><br></br><light>one</light> <strong>complete experience.</strong>","cta":"Explore cases","imageAlt":"Real estate launch environment created by Grupo Flying"},"intro":{"statement":"<strong>From the idea to the sales experience,</strong> <muted>every discipline speaks the same language.</muted>","companies":{"ogdi":{"desc":"The ecosystem's starting point. From opportunity to launch: structuring, feasibility and real-estate product design — the intelligence that makes value be born before construction.","cta":"Discover OGDI"},"nid":{"desc":"The architecture of desire. Interiors, facades, sales stands and decorated model homes — the strategic design that precedes the sale and sets the stage where the buying decision happens.","cta":"Discover NID Studio"},"flying":{"desc":"The group's mother company. Born to give shape to the invisible, it orchestrates the arsenal that enchants, immerses and sells — high-impact imagery, apps, D.sbrave, immersive rooms and augmented reality. We don't just display tomorrow: we make it felt.","cta":"Discover our DNA"},"rinno":{"desc":"The narrative that sells. Concept, product, viral and documentary films that tell the development's story magnetically — turning square meters into life narratives.","cta":"Discover Rinno Films"}}},"ecosystemRings":{"title":"A complete ecosystem"},"words":{"speed":"Speed.","coherence":"Coherence.","conversion":"Conversion."},"ecosystem":{"ogdi":{"name":"OGDI","eyebrow":"OGDI","title":"The strategic starting point.","description":"From concept and market intelligence to the complete structuring of new launches, connecting product, partners and viability from the very beginning."},"nid":{"name":"NID Studio","eyebrow":"NID STUDIO","title":"Where architectural intelligence gains form and emotion.","description":"Architecture, interiors, façades, landscaping and sales spaces designed to materialize the essence of each development."},"flying":{"name":"Flying Studio","eyebrow":"FLYING STUDIO","title":"Our machine for anticipating futures.","description":"Images, animations and interactive technologies that make visible what is yet to exist and transform presentation into experience."},"rinno":{"name":"Rinno Films","eyebrow":"RINNO FILMS","title":"Movement for stories that deserve to be felt.","description":"Concept, product and institutional films that translate differentiators into narratives capable of creating connection and desire."}},"featured":{"eyebrow":"FEATURED CASE","description":"A launch built by different specialties, from architecture to the digital experience.","seeComplete":"View full case","imageAlt":"Meeting in The One Saúde sales environment"},"projects":{"title":"Intelligence translated into <accent>experience</accent>.","seeComplete":"View full case","items":{"macuco-grand-canal":{"description":"Club-scale leisure and a visual narrative that presents every space before construction."},"canvas-altino":{"description":"From the place's vocation to the narrative that sells: a complete launch, desired before it existed."},"the-one-tucuruvi":{"description":"Compact living turned into grandeur, with the whole city inside the studio."},"livigno":{"description":"Graphite presence, welcoming interiors and an elegance felt before the visit."}}},"cta":{"eyebrow":"THE NEXT CASE IS YOURS","title":"Your launch at the <accent>center of the ecosystem.</accent>","description":"Four forces speaking the same language, from product design to the experience that sells — an entire universe conspiring in favor of your next great sale.","button":"Talk to Grupo Flying"},"detail":{"hero":{"eyebrow":"CASE STUDY"},"ficha":{"type":"Type","location":"Location","scope":"Scope"},"visitLabel":"Discover {name}","seeMore":"See more","nextCase":"Next case","items":{"macuco-grand-canal":{"heroDescription":"A launch built on every front, from product concept to the film that presents it.","statement":"A whole world at a single <accent>address</accent>.","narrative":"Macuco Grand Canal is born from generosity: a product that gathers leisure, wellness and conviviality at club scale, spaces designed for every age and a visual narrative that makes each space feel lived in before construction.","ficha":{"type":"Residential","location":"Santos, Brazil","scope":"Concept, design, visualization, app and film"},"services":{"ogdi":"Led the vocation analysis and concept development for the project.","nid":"Designed the shared amenities décor, the facade and the launch's sales stand.","flying":"Produced the development's images and the launch's sales app.","rinno":"Produced the Concept Film, the Broker Film and the social media clips."}},"canvas-altino":{"heroDescription":"A launch built on every front, from product strategy to the emotion of the sale.","statement":"Before the concrete, the <accent>concept</accent>.","narrative":"Canvas Altino is born from the meeting of strategy and sensibility: a product conceived from the place's vocation, a sales stage designed to enchant, and a visual narrative that made the development desired before it existed.","ficha":{"type":"Residential","location":"Presidente Altino | Osasco, Brazil","scope":"Concept, architecture, visualization, app and film"},"services":{"ogdi":"Handled the vocation analysis and concept development for the project.","nid":"Created the sales stand, the decorated model apartment, the shared amenities and the facade design.","flying":"Produced the project's images and the sales app.","rinno":"Produced the Concept Film, the Product Film, the Viral Film and the LED panel clips."}},"the-one-tucuruvi":{"heroDescription":"A launch that turns compact living into grandeur, from product design to the sales experience.","statement":"A few meters, a whole <accent>metropolis</accent>.","narrative":"The One Tucuruvi is born from precision: a product designed around the essential, an architecture that expands every meter, and a visual narrative that brings the whole city inside the studio.","ficha":{"type":"Residential — studios","location":"Tucuruvi | São Paulo, Brazil","scope":"Concept, architecture, visualization, app and film"},"services":{"ogdi":"Handled the vocation analysis and concept development for the project.","nid":"Created the project's facade and interior design.","flying":"Produced the project's images and the sales app.","rinno":"Produced the launch's Product and Viral films."}},"livigno":{"heroDescription":"A launch built in the details, from product concept to spaces that embrace daily life.","statement":"Desire lives in the <accent>details</accent>.","narrative":"Livigno is born from the balance between presence and warmth: a product conceived with clarity, spaces designed for real life, and a visual experience that makes its elegance felt before the visit.","ficha":{"type":"Residential","location":"São Paulo, Brazil","scope":"Concept, architecture, visualization, app and film"},"services":{"ogdi":"Handled the vocation analysis and concept development for the project.","nid":"Created the sales stand, the decorated units, the shared amenities and the executive architectural project.","flying":"Produced the project's images and the sales app.","rinno":"Produced the launch's Concept, Product and Viral films."}}}}},"FuturePage":{"eyebrow":"Coming soon","description":"This page is still under construction, but it has already been prepared in the navigation to support the site's expansion."}},"now":"$undefined","timeZone":"America/Sao_Paulo","children":"$L21"}]
