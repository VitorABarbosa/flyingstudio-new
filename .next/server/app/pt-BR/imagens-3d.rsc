12:["$","$L20",null,{"formats":"$undefined","locale":"pt-BR","messages":{"Home":{"hero":{"eyebrow":"Onde a imaginação ganha endereço","titleLine":"Muito além das","titleWord":"perspectivas","support":"Há 15 anos transformamos empreendimentos em imagens, filmes e experiências imersivas que vendem antes do primeiro tijolo.","ctaPrimary":"Explorar serviços","ctaSecondary":"Falar com o estúdio","metaLocation":"São Paulo — Brasil","metaSince":"Desde 2010","metaMarket":"Mercado imobiliário","scrollCue":"Abaixe para explorar","tagline":"Muito além das perspectivas"},"dsbrave":{"eyebrow":"Produto próprio","title":"Conheça o D.sbrave","subtitle":"Uma vivência imersiva por dentro do empreendimento","cta":"Conhecer o D.sbrave","demoLabel":"Demonstração ao vivo","demoHint":"Ativar modo interativo","demoActive":"Modo interativo ativo — arraste para explorar","views":{"loteamento":"Loteamento","predio":"Prédio"}},"partners":{"title":"Muito mais que clientes","subtitle":"Parceiros, amigos e uma verdadeira família."},"cta":{"titleStart":"Dê o próximo","titleAccent":"passo","primary":"Iniciar um projeto","whatsapp":"Chamar no WhatsApp","emailLabel":"ou escreva para"},"grupo":{"eyebrow":"Nosso Grupo","titleStart":"Uma essência,","titleAccent":"quatro olhares","narrative":"Um grande lançamento exige maestria em múltiplas frentes — e é assim que o Grupo Flying trabalha: empresas especializadas operando em perfeita sinergia, da análise de vocação e formatação do produto ao design, ao audiovisual e à tecnologia do lançamento. Quando todas as frentes falam a mesma língua, o resultado se traduz em velocidade, coerência e conversão.","cta":"Conheça o grupo por dentro","visitLabel":"Conhecer o site","visitFlying":"Conhecer nosso DNA","companies":{"flying":{"name":"Flying Studio","slogan":"Muito além das perspectivas.","role":"Ecossistema de lançamentos","desc":"Orquestramos um arsenal tecnológico projetado para encantar, imergir e vender — imagens, aplicativos, imersão 360º, filmes e experiências que tangibilizam o amanhã."},"rinno":{"name":"Rinno Films","slogan":"Seu Projeto Merece Cinema.","role":"Produtora audiovisual","desc":"A narrativa que vende: filmes conceituais, de produto, virais e documentários."},"nid":{"name":"NID Studio","slogan":"Seu Ninho Criativo.","role":"Design estratégico","desc":"A arquitetura do desejo: interiores, fachadas, estandes de vendas e decorados."},"ogdi":{"name":"Open Group","slogan":"O Valor nasce antes da obra.","role":"Desenvolvimento imobiliário","desc":"Da oportunidade ao lançamento: estruturação, viabilidade, formatação e lançamento."}}}},"Hero":{"headline":"Tecnologia Artística 3D","titleStart":"Nós fazemos o amanhã","titleAccent":"ser sentido.","subtitle":"Da primeira imagem à decisão de compra","label":"SOMOS EXPERT NO MERCADO IMOBILIÁRIO","tagline":"Muito além das perspectivas","cards":{"images":{"title":"Imagens de\nAlto Impacto","description":"A primeira impressão que define a venda. Rigor estético, luz, enquadramento e humanização para capturar a <b>essência do projeto</b> e despertar o <b>desejo imediato</b>.","cta":"Quero saber mais"},"video":{"title":"Filmes\nEstratégicos","description":"Não fazemos vídeos: contamos a história do empreendimento de forma magnética. Conceituais, de produto, virais e documentários que <b>transformam metros quadrados em narrativas de vida</b>.","cta":"Quero saber mais"},"tech":{"title":"Aplicativos\nComerciais","description":"O controle absoluto da narrativa. Conteúdo em camadas e sequências lógicas criam uma <b>trilha de convencimento</b> que guia a decisão passo a passo, <b>independentemente de quem apresenta</b>.","cta":"Quero saber mais"},"tour":{"title":"Tour Virtual\n360º","description":"A vivência hiper-realista: o cliente explora cada ambiente em todos os ângulos, <b>tangibilizando o espaço</b> e <b>eliminando objeções de compra</b>.","cta":"Quero saber mais"},"dsbrave":{"title":"Conheça o\nD.sbrave","description":"A máquina do tempo 360º. O comprador <b>caminha pelo futuro lar</b> com total autonomia e começa ali a criar as suas histórias.","cta":"Quero saber mais"}}},"Sobre":{"label":"FLYING STUDIO","intro":"Em 9 de maio de 2011 abrimos nossas portas com uma crença simples e poderosa: uma imagem vale mais do que mil palavras. Desde então somos a ponte entre a ideia e a venda, materializando o sonho do comprador antes do primeiro tijolo ser assentado.","years":"Nascemos para dar forma ao invisível.","description":"A arte sempre será o nosso compasso, mas a trajetória nos trouxe algo ainda mais valioso: a precisão mercadológica. Acompanhamos o nascimento de centenas de empreendimentos e entendemos o que faz um projeto vender.","cta":"Conheça a Flying Studio"},"ServiceBridge":{"images3d":{"question":"A emoção cresce em movimento.","action":"Conheça os Filmes"},"videos3d":{"question":"Agora, o empreendimento na mão do corretor.","action":"Conheça os Aplicativos"},"apps":{"question":"O próximo passo é caminhar por dentro do projeto.","action":"Explorar o Tour Virtual 360"},"tour360":{"question":"Tudo isso, reunido em um só lugar.","action":"Descubra o D.sbrave"},"dsbrave":{"question":"Tudo começa com uma boa imagem.","action":"Ver as Imagens 3D"}},"Nav":{"services":"Serviços","portfolio":"Portfólio","about":"Sobre","contact":"Contato","languageSwitcher":"EN"},"Header":{"navLabel":"Menu principal","openMenu":"Abrir menu","nav":{"home":"Home","about":"Sobre Nós","services":"Serviços","cases":"Nosso Grupo","join":"Junte-se a Nós","news":"Flying News"},"services":{"images3d":"Imagens","videos3d":"Filmes","apps":"Aplicativos","dsbrave":"D.sbrave","tour360":"Tour Virtual 360º"},"contact":"Contato","closeMenu":"Fechar menu","switchLanguageLabel":"Mudar para {language}"},"DSbrave":{"label":"GESTÃO","title":"Conheça o D.sbrave","subtitle":"Gestão inteligente para projetos de alto desempenho","description":"Criamos Imagens 3D com tecnologia exclusiva para visualização arquitetônica de alto padrão.","cta":"Conhecer o D.sbrave"},"DSbravePage":{"hero":{"home":"Home","eyebrow":"Serviço"},"explainer":{"eyebrow":"O QUE É O","title":"O futuro na palma da mão.","description":"O aplicativo exclusivo de imersão 360º da Flying: total autonomia para o comprador caminhar pelo futuro lar, explorar cada ambiente em todos os ângulos e começar ali a criar as suas histórias. E ele não para na venda — do primeiro render ao acompanhamento da obra, a operação inteira trabalha no mesmo lugar."},"module":{"prevLabel":"Voltar módulos","nextLabel":"Avançar módulos","items":{"splitview":{"title":"Split View","description":"Acompanhamento da obra em tempo real, lado a lado com o projeto."},"lotes":{"title":"Automação de Lotes","description":"Reservas e disponibilidade atualizadas instantaneamente."},"mapa":{"title":"Mapa Interativo de Arredores","description":"Visualização aérea 360° via drone, com pins de outros empreendimentos e integração direta com seus sites."},"exploracao":{"title":"Exploração 360°","description":"Ambientes explorados em alta qualidade, direto no hub."},"unify":{"title":"Unifica os tours","description":"Reúne os ambientes virtuais do projeto em uma única central de acesso."},"guide":{"title":"Guia a visita","description":"Ajuda o usuário a entender o empreendimento como jornada, não como conteúdo solto."},"desire":{"title":"Constrói desejo","description":"Aproxima o cliente da rotina, dos espaços e da sensação de futuro lar."},"standalone":{"title":"Módulo próprio","description":"Uma experiência independente para campanhas, lançamentos e apresentações comerciais."},"app":{"title":"Dentro do app","description":"Também pode ser incorporado ao aplicativo do empreendimento como área imersiva."}}},"projects":{"eyebrow":"QUEM JÁ USA","title":"Projetos com D.sbrave","prevLabel":"Voltar projetos","nextLabel":"Avançar projetos"},"demo":{"headline":"Veja o D.sbrave em ação.","button":"Solicitar demonstração"}},"Images3DPage":{"hero":{"home":"Home","eyebrow":"Serviço","title":"Imagens"},"sections":{"geral":{"title":"Geral","description":"Conheça alguns dos nossos projetos."},"loteamentos":{"title":"Loteamentos","description":"Projetos voltados à apresentação de áreas de lazer, paisagismo e experiências visuais externas."},"fachadas":{"title":"Fachadas","description":"Estudos de fachada e volumetria para destacar a proposta arquitetônica do empreendimento."},"plantas-humanizadas":{"title":"Plantas Humanizadas","description":"Representações planejadas para comunicar layout, circulação e aproveitamento do espaço com clareza."},"internas":{"title":"Internas","description":"Perspectivas internas criadas para transmitir atmosfera, acabamento, iluminação e experiência de uso."},"externas":{"title":"Externas","description":"Perspectivas externas criadas para transmitir atmosfera, acabamento, iluminação e experiência de uso."}},"seeMoreLabel":"Ver mais","lightbox":{"previous":"Imagem anterior","next":"Próxima imagem","close":"Fechar"},"ctaHeadline":"Vamos dar forma ao seu empreendimento.","ctaLabel":"Quero minhas perspectivas"},"Videos3DPage":{"hero":{"home":"Home","eyebrow":"Serviço","title":"Filmes"},"tabs":{"todos":"Todos","conceitos":"Conceitos","produtos":"Produtos","virais":"Virais"},"sections":{"conceitos":{"title":"Conceitos","description":"Filmes conceituais focados no lifestyle e no posicionamento da marca, conectando o empreendimento à emoção do comprador."},"produtos":{"title":"Produtos","description":"Um mergulho profundo na arquitetura, infraestrutura e diferenciais técnicos, valorizando cada metro quadrado do empreendimento."},"virais":{"title":"Virais","description":"Formatos curtos e dinâmicos em 9:16, otimizados para gerar engajamento nas redes sociais e campanhas de tráfego pago."}},"carousel":{"prevLabel":"Voltar na seção {title}","nextLabel":"Avançar na seção {title}","pageLabel":"Ir para a página {page}","closeLabel":"Fechar vídeo","openLabel":"Abrir vídeo {title}","expandLabel":"Ampliar vídeo {title}","seeMoreRinno":"Veja mais na Rinno Films"},"rinno":{"eyebrow":"Rinno Films · Grupo Flying","leadQuestion":"Procurando filmes documentários e institucionais?","leadAnswer":"São com a <rinno>Rinno Films</rinno> — a mesma produtora por trás de todos os filmes desta página.","titlePre":"Aqui nasce o","titleAccent":"cinema imobiliário.","description":"A produtora do grupo trata cada empreendimento como roteiro: documentários que eternizam a primeira centelha criativa, filmes conceituais e de produto que despertam o desejo, e narrativas virais que dominam as redes.","cta":"Conhecer a Rinno Films"}},"AplicativosPage":{"hero":{"home":"Home","eyebrow":"Serviço","title":"Aplicativos"},"explainer":{"eyebrow":"O QUE É O APLICATIVO","title":"O controle da apresentação.","description":"O controle absoluto da narrativa comercial. Aplicações interativas que centralizam o empreendimento inteiro — renders, filmes, plantas e tours 360º num só ambiente — e vão além: o conteúdo é estruturado em camadas e sequências lógicas, criando uma trilha de convencimento que guia a decisão do cliente passo a passo."},"benefits":{"prevLabel":"Voltar diferenciais","nextLabel":"Avançar diferenciais","items":{"sob-medida":{"title":"Design sob medida","description":"Cada aplicação é única para a incorporadora, reforçando a marca do empreendimento."},"multiplataforma":{"title":"Qualquer dispositivo","description":"Pode ser acessado em qualquer dispositivo, sem necessidade de instalação."},"a-prova-de-falhas":{"title":"À prova de falhas","description":"A grandiosidade e o poder de persuasão do projeto mantêm a força total, independentemente de quem conduz a apresentação."},"corretor":{"title":"Na mão do corretor","description":"No estande ou onde a venda acontecer, o corretor conduz a apresentação e responde na hora: planta, implantação, vista do andar."}}},"projects":{"eyebrow":"SOLUÇÕES EM APLICATIVOS","title":"Projetos Personalizados","prevLabel":"Voltar projetos","nextLabel":"Avançar projetos"},"demo":{"headline":"Veja o Aplicativo em ação.","button":"Solicitar demonstração"}},"Tour360Page":{"hero":{"home":"Home","eyebrow":"Serviço","title":"Tour Virtual 360°"},"explainer":{"eyebrow":"O QUE É O TOUR VIRTUAL","title":"O fim das objeções.","description":"Uma vivência hiper-realista em 360º: o cliente explora cada detalhe, em todos os ângulos e ambientes, tangibilizando o espaço muito antes do primeiro tijolo. O que a planta não explica e a imagem não responde, o tour resolve — de qualquer tela, por um link."},"benefits":{"prevLabel":"Voltar diferenciais","nextLabel":"Avançar diferenciais","items":{"1":{"title":"Seu Produto Imersivo","description":"Seu tour virtual é apresentado com mais contexto e valor percebido pelo cliente."},"2":{"title":"Experiência Personalizada","description":"Cada tour pode ser ajustado para reforçar a experiência e o propósito do empreendimento."},"3":{"title":"Múltiplas Interações","description":"Adicione pontos clicáveis, informações relevantes e navegação guiada no ambiente."},"4":{"title":"Seu Produto Em Um Novo Mundo","description":"Uma forma inovadora de apresentar seu produto de maneira memorável e interativa."}}},"projects":{"eyebrow":"SOLUÇÕES EM TOUR VIRTUAL 360°","title":"Conheça Nossos Projetos","prevLabel":"Voltar projetos","nextLabel":"Avançar projetos"},"demo":{"headline":"Veja o Tour Virtual em ação.","button":"Solicitar demonstração"}},"DnaPage":{"hero":{"metaSince":"Desde 2011","metaPlace":"São Paulo — Brasil","subtitle":"Conheça nossa essência na raiz.","description":"Em 9 de maio de 2011, abrimos nossas portas com uma crença simples e poderosa: uma imagem vale mais do que mil palavras. Dessa crença nasceu tudo o que somos.","scrollLabel":"Ir para a nossa história"},"historia":{"eyebrow":"NOSSA","title":"História","foundedLabel":"Desde 9 de maio de 2011","description":"Durante anos, fomos a ponte entre a ideia e a venda, materializando virtualmente o sonho do comprador antes do primeiro tijolo ser assentado. Provamos que a nossa arte não é apenas ilustrar a realidade — é fazer o cliente vivenciar o futuro. Muito além das perspectivas sempre foi o nosso lema e, secretamente, a nossa profecia.","description2":"Ao longo de quase duas décadas, enquanto ilustrávamos o amanhã para os maiores players do mercado, fomos absorvendo a inteligência por trás de cada sucesso e a sabedoria por trás do insucesso. Acompanhamos o nascimento de centenas de empreendimentos e entendemos o que faz um projeto vender: o que atrai o olhar do investidor, o que acelera um lançamento e o que transforma um terreno em um verdadeiro case de sucesso e desejo.","imageAlt1":"Equipe da Flying Studio no escritório","imageAlt2":"Estúdio da Flying Studio","imageAlt3":"Mural 'uma imagem vale mais que mil palavras' no escritório","prevLabel":"Slide anterior","nextLabel":"Próximo slide"},"essencia":{"titlePre":"O que é ser","prevLabel":"Slide anterior","nextLabel":"Próximo slide","slides":{"cultura":{"eyebrow":"NOSSA","title":"Cultura","description":"Nossa cultura é baseada na união entre estratégia, criatividade e colaboração para entregar soluções de alto valor. Atuamos com precisão mercadológica, utilizando inteligência e conhecimento do mercado para orientar nossas decisões. Valorizamos a agilidade na execução, sem abrir mão da qualidade, e acreditamos em um ecossistema unificado, onde a comunicação clara e a integração entre as áreas eliminam ruídos e proporcionam uma experiência consistente para clientes e equipe."},"proposito":{"eyebrow":"NOSSO","title":"Propósito","description":"Uma imagem impecável é o convite perfeito, mas o nosso objetivo tornou-se maior: assumir o controle de toda a experiência de compra. Desenhamos um ecossistema onde a tecnologia é um convite ao encantamento — e a atração visual é apenas o primeiro ato de um grande espetáculo de conversão."},"manifesto":{"eyebrow":"NOSSO","title":"Manifesto","description":"Nascemos para dar forma ao invisível. Não entregamos apenas produtos: orquestramos um arsenal tecnológico projetado para encantar, imergir e vender — imagens, aplicativos, imersão 360º, filmes e experiências que tangibilizam o amanhã."}},"pilares":{"missao":{"title":"Missão","description":"Materializar o futuro antes da obra, transformando projetos em experiências que inspiram confiança, despertam desejo e aceleram decisões de compra."},"visao":{"title":"Visão","description":"Consolidar o maior ecossistema de experiências de marca da América Latina e expandir nossa presença internacional, tornando-nos referência mundial em inovação, excelência e transformação de projetos em experiências de alto impacto."},"valores":{"title":"Valores","description":"Rigor estético em cada detalhe, inteligência em cada decisão e sinergia total entre criação, tecnologia e estratégia — para que a grandiosidade de um projeto nunca se perca no caminho."}}},"statement":{"headline":"Nós não apenas exibimos o amanhã — nós o fazemos ser sentido.","complement":"Se uma imagem fala mais do que mil palavras, imagine o poder de um universo digital inteiro conspirando a favor do seu próximo grande lançamento."},"qg":{"eyebrow":"NOSSO QG","title":"O epicentro da tecnologia imobiliária","address":"Av. Engenheiro Luís Carlos Berrini — Itaim Bibi, São Paulo, SP","description":"Mais que um estúdio: um laboratório de inovação onde mentes criativas, desenvolvedores de tecnologia e estrategistas de lançamento atuam em total sinergia. Onde quer que o seu empreendimento esteja nascendo, é daqui que orquestramos a inteligência visual e tecnológica que o fará dominar o mercado."},"vozes":{"eyebrow":"VOZES DO DNA","title":"Quem vive a Flying, conta","description":"Cinco perguntas, dezenas de histórias reais. Role a linha e mergulhe no que transforma um trabalho em pertencimento.","playLabel":"Assistir depoimento","closing":"Nunca é cedo e nem tarde para começar. Essa é a linha que conecta cada história daqui — e ela continua sendo escrita.","ctaLabel":"Assistir ao vídeo completo","items":{"transformacao":{"eyebrow":"TRANSFORMAÇÃO","question":"O que o seu 'eu' do passado ficaria mais surpreso em saber sobre quem você é hoje?","quote":"Você demorou demais para aceitar esse desafio."},"pertencimento":{"eyebrow":"PERTENCIMENTO","question":"O que diferencia a Flying de qualquer outro lugar que você já trabalhou?","quote":"Aqui não existe teto para o crescimento. É irmandade."},"pluralidade":{"eyebrow":"PLURALIDADE","question":"Na prática, o que significa 'nunca é cedo e nem tarde para começar'?","quote":"Dos 15 anos do Pablo aos 48 do Enrique — a mesma fome de aprender."},"impacto":{"eyebrow":"IMPACTO REAL","question":"Qual é a sensação de ver um projeto seu materializado na rua?","quote":"'Foi meu marido que fez' — o 3D que vira o sonho de uma família."},"proposito":{"eyebrow":"PROPÓSITO","question":"Por que o transbordo de conhecimento é o pilar principal da Flying?","quote":"O CNPJ é só uma formalidade para CPFs se conectarem."}}},"grupo":{"titlePre":"Nosso","titleAccent":"Grupo","description":"Um grande lançamento exige maestria em múltiplas frentes. O Grupo Flying reúne empresas especializadas operando em perfeita sinergia — da formatação do produto à tecnologia do lançamento. Quando todas as frentes falam a mesma língua, o resultado é velocidade, coerência e conversão.","visitLabel":"Visitar o site","openLabel":"Ver detalhes","closeLabel":"Fechar","companies":{"flying":{"name":"Flying Studio","role":"Tecnologia artística 3D","description":"A empresa-mãe do grupo: imagens, aplicativos, tours e experiências imersivas para lançamentos imobiliários.","services":["Imagens 3D","Aplicativos","D.sbrave","Tour 360º"]},"rinno":{"name":"Rinno Films","role":"Produtora audiovisual","description":"A narrativa que vende: filmes conceituais, de produto, virais e documentários para o mercado imobiliário.","services":["Filme Conceito","Filme Produto","Filme Viral","Filme DOC"]},"nid":{"name":"NID Studio","role":"Design estratégico","description":"A arquitetura do desejo: projetos de interiores, fachadas, estandes de vendas e apartamentos decorados.","services":["PDV","Decorado","Fachadas","Interiores"]},"ogdi":{"name":"Open Group Desenvolvimento Imobiliário","role":"Estruturação e Desenvolvimento Imobiliário","description":"Transforma oportunidades imobiliárias em empreendimentos prontos para avançar: da conceituação ao lançamento, com viabilidade, parceiros e visão desde a origem.","services":["Estruturação","Viabilidade","Produto Imobiliário","Lançamento"]}},"cta":"Conheça o grupo por dentro"},"parceiros":{"titlePre":"Muito mais que clientes,","titleHighlight":"parceiros."}},"NossoGrupo":{"title":"Conheça","titleHighlight":"Nosso Grupo","subtitle":"Venha conhecer o grupo por trás dessa experiência e descubra o que nos move","cards":{"card1":{"name":"Cosmopolitan","description":"OXE ENGENHARIA"},"card2":{"name":"The One Saúde","description":"OUSY"},"card3":{"name":"G3 Move","description":"GREMP3"},"card4":{"name":"Vita Vila Prudente","description":"ENGECASTRO"},"card5":{"name":"Livigno","description":"TAVARES E ROSSETI"}}},"Footer":{"phone":"(11) 2351-4138","email":"studio@flyingstudio.com.br","address":"Av. Engenheiro Luís Carlos Berrini — Itaim Bibi, São Paulo, SP","ariaLabel":"Flying Studio no {name}"},"Contato":{"hero":{"home":"Home","label":"Contato","bannerAlt":"Escritório da Flying Studio","ariaHeading":"Vamos começar um projeto juntos.","words":{"w1":"Vamos","w2":"começar","w3":"um","w4":"projeto","w5":"juntos."}},"form":{"title":"Preencha seus dados","fields":{"company":{"label":"Nome Empresarial"},"email":{"label":"E-mail"},"whatsapp":{"label":"Whatsapp"},"responsible":{"label":"Responsável"},"subject":{"label":"O que você precisa?","placeholder":"Selecione o assunto","options":{"imagens":"Imagens 3D","filmes":"Filmes 3D","aplicativos":"Aplicativos","tour":"Tour Virtual 360º","dsbrave":"D.sbrave","lancamento":"Um lançamento completo","outro":"Outro assunto"}}},"privacyPrefix":"Eu aceito a","privacyLink":"Política de Privacidade","submit":"Estou Pronto","submitted":"Enviado!","sending":"Enviando...","error":"O envio falhou agora. Tente de novo em instantes ou chame no WhatsApp."},"meeting":{"title":"Todo lançamento começa com","titleHighlight":"uma conversa.","text":"Um especialista da Flying entende o seu projeto e responde no WhatsApp.","cta":"Falar com um especialista"}},"JunteSeANos":{"hero":{"home":"Home","label":"Junte-se a Nós","title":"Seja Flying Studio","bannerAlt":"Equipe da Flying Studio trabalhando no estúdio"},"bancoTalentos":{"label":"Banco de Talentos","titleLine1":"Junte-se","titleLine2":"a nós","paragraph":"Nosso QG na Berrini é mais que um estúdio: é um laboratório onde mentes criativas, desenvolvedores de tecnologia e estrategistas de lançamento trabalham na mesma sala. É dessa sinergia que nasce tudo o que fazemos — e é gente assim que estamos sempre procurando.","closing":"Vamos construir algo extraordinário juntos!","fields":{"name":{"label":"Nome Completo"},"area":{"label":"Área desejada:","placeholder":"Selecione"},"email":{"label":"E-mail"},"whatsapp":{"label":"Whatsapp"}},"areas":{"administrativo":"Administrativo","arte":"Arte e Criação","tecnologia":"Tecnologia","arquitetura":"Arquitetura","other":"Outros"},"uploadTitle":"Adicione o currículo aqui","uploadHint":"arraste o arquivo ou clique na área","submit":"Enviar Currículo","submitted":"Currículo enviado!","sending":"Enviando...","error":"O envio falhou agora. Tente de novo em instantes."}},"Metadata":{"title":"Flying Studio — Muito Além das Perspectivas","description":"Há 15 anos transformamos lançamentos imobiliários em experiência: perspectivas 3D, filmes, aplicativo de vendas, tour virtual 360º e imersão que vendem antes da obra.","keywords":"perspectivas 3D, maquete eletrônica, imagens 3D imobiliárias, filmes imobiliários, aplicativo de vendas, tour virtual 360º, visualização arquitetônica, lançamento imobiliário","ogImageAlt":"Flying Studio — tecnologia artística 3D para lançamentos imobiliários","pages":{"dna-flying-studio":{"title":"Sobre Nós","description":"Conheça a história, a cultura e o ecossistema do Grupo Flying: 15 anos dando forma ao invisível para os maiores lançamentos do mercado imobiliário."},"imagens-3d":{"title":"Imagens 3D e Perspectivas","description":"Perspectivas 3D hiper-realistas de fachadas, áreas comuns, interiores e plantas humanizadas — imagens que vendem o empreendimento antes da obra."},"videos-3d":{"title":"Filmes Imobiliários","description":"Filmes conceito, produto e virais produzidos pela Rinno Films: o cinema imobiliário que transforma metros quadrados em narrativas de vida."},"aplicativos":{"title":"Aplicativo de Vendas","description":"O aplicativo comercial que centraliza o lançamento inteiro — renders, filmes, plantas e tours 360º — numa trilha de convencimento que guia a decisão do cliente."},"tour-virtual-360":{"title":"Tour Virtual 360º","description":"A vivência hiper-realista do empreendimento: o cliente explora cada ambiente em todos os ângulos, eliminando objeções antes do primeiro tijolo."},"dsbrave":{"title":"D.sbrave — Imersão 360º","description":"A máquina do tempo 360º: o comprador caminha pelo futuro lar com total autonomia, do estande de vendas ou de qualquer tela."},"cases":{"title":"Nosso Grupo e Cases","description":"O ecossistema do Grupo Flying em ação: OGDI, NID, Flying Studio e Rinno Films assinando lançamentos completos, da concepção à venda."},"contato":{"title":"Contato","description":"Fale com a Flying Studio e vamos dar forma ao seu próximo lançamento imobiliário — imagens, filmes, aplicativo e imersão 360º."},"junte-se-a-nos":{"title":"Junte-se a Nós","description":"Trabalhe no Grupo Flying: envie seu currículo para o banco de talentos do nosso QG na Berrini, em São Paulo."},"flying-news":{"title":"Flying News","description":"Novidades, bastidores e lançamentos do universo Flying Studio."}}},"Sidebar":{"ariaLabel":"Menu lateral principal","close":"Fechar menu","languageLabel":"Mudar para {locale}","ctaTitle":"Vamos começar um projeto juntos.","ctaButton":"Solicitar Orçamento","links":{"home":"Home","dna":"DNA Flying Studio","images3d":"Imagens 3D","videos3d":"Vídeos 3D","apps":"Aplicativos","tour360":"Tour Virtual 360º","dsbrave":"D.sbrave","join":"Junte-se a Nós","news":"Flying News","cases":"Nosso Grupo","contact":"Contato"}},"FlyingNews":{"hero":{"title":"Flying News","tagline":"O Studio que muda suas perspectivas","categories":{"market":{"title":"Notícias & Mercado","description":"Novidades e Mercado Imobiliário"},"innovation":{"title":"Inovação & Tendências","description":"O que tem de novo para inovar!"}}},"highlights":{"eyebrow":"DESTAQUES","title":"Flying News","articleDate":"São Paulo, 02.04.2026","articleExcerpt":"Lorem Ipsum is simply dummy text of the printing and typesetting industry.","readMore":"Continue Lendo","allEditions":"Ver Todas as Edições","articles":{"entrada-residencial":{"title":"Lorem Ipsum is simply dummy text of the printing...","imageAlt":"Entrada de empreendimento residencial"},"area-comercial":{"title":"Lorem Ipsum is simply dummy text of the printing.","imageAlt":"Área comercial contemporânea"},"fachada-residencial":{"title":"Lorem Ipsum is simply dummy text of the printing...","imageAlt":"Fachada de empreendimento residencial"},"area-de-lazer":{"title":"Lorem Ipsum is simply dummy text.","imageAlt":"Área de lazer com piscina"}}},"market":{"title":"Notícias & Mercado","subtitle":"NOVIDADES E MERCADO IMOBILIÁRIO","articleTitle":"Lorem Ipsum is simply dummy text of the printing and typesetting industry.","articleDate":"São Paulo, 02.04.2026","articleExcerpt":"Lorem Ipsum is simply dummy text of the printing and typesetting industry.","readMore":"Continue Lendo","previous":"Página anterior","next":"Próxima página","pageLabel":"Ir para a página"},"innovation":{"title":"Inovação & Tendências","subtitle":"O QUE TEM DE NOVO PARA INOVAR?","articleTitle":"Lorem Ipsum is simply dummy text of the printing and typesetting industry.","articleDate":"São Paulo, 02.04.2026","articleExcerpt":"Lorem Ipsum is simply dummy text of the printing and typesetting industry.","readMore":"Continue Lendo","previous":"Página anterior de inovação","next":"Próxima página de inovação","pageLabel":"Ir para a página de inovação"}},"CasesPage":{"hero":{"home":"Home","label":"Nosso Grupo","title":"<strong>Um</strong> <light>projeto</light><br></br><strong>quatro</strong> <light>olhares</light><strong>,</strong><br></br><light>uma</light> <strong>experiência completa.</strong>","cta":"Explorar cases","imageAlt":"Ambiente de lançamento imobiliário criado pelo Grupo Flying"},"intro":{"statement":"<strong>Da ideia à experiência de venda,</strong> <muted>todas as frentes falam a mesma língua.</muted>","companies":{"ogdi":{"desc":"O ponto de partida do ecossistema. Da oportunidade ao lançamento: estruturação, viabilidade e formatação de produto imobiliário — a inteligência que faz o valor nascer antes da obra.","cta":"Conhecer a OGDI"},"nid":{"desc":"A arquitetura do desejo. Interiores, fachadas, estandes de vendas e decorados — o design estratégico que precede a venda e desenha o palco onde a decisão de compra acontece.","cta":"Conhecer a NID Studio"},"flying":{"desc":"A empresa-mãe do grupo. Nascida para dar forma ao invisível, orquestra o arsenal que encanta, imerge e vende — imagens de alto impacto, aplicativos, D.sbrave, salas imersivas e realidade aumentada. Nós não apenas exibimos o amanhã: nós o fazemos ser sentido.","cta":"Conhecer nosso DNA"},"rinno":{"desc":"A narrativa que vende. Filmes conceituais, de produto, virais e documentários que contam a história do empreendimento de forma magnética — transformando metros quadrados em narrativas de vida.","cta":"Conhecer a Rinno Films"}}},"ecosystemRings":{"title":"Um ecossistema completo"},"words":{"speed":"Velocidade.","coherence":"Coerência.","conversion":"Conversão."},"ecosystem":{"ogdi":{"name":"OGDI","eyebrow":"OGDI","title":"O ponto de partida estratégico.","description":"Da conceituação e inteligência de mercado à estruturação completa de novos lançamentos, conectando produto, parceiros e viabilidade desde o início."},"nid":{"name":"NID Studio","eyebrow":"NID STUDIO","title":"Onde a inteligência arquitetônica ganha forma e emoção.","description":"Arquitetura, interiores, fachadas, paisagismo e PDVs pensados para materializar a essência de cada empreendimento."},"flying":{"name":"Flying Studio","eyebrow":"FLYING STUDIO","title":"A nossa máquina de antecipar futuros.","description":"Imagens, animações e tecnologias interativas que tornam visível o que ainda está por existir e transformam apresentação em experiência."},"rinno":{"name":"Rinno Films","eyebrow":"RINNO FILMES","title":"Movimento para histórias que merecem ser sentidas.","description":"Filmes conceito, de produto e institucionais que traduzem diferenciais em narrativas capazes de criar conexão e desejo."}},"featured":{"eyebrow":"CASE EM DESTAQUE","description":"Um lançamento construído por diferentes especialidades, da arquitetura à experiência digital.","seeComplete":"Ver completo","imageAlt":"Reunião no espaço de vendas do The One Saúde"},"projects":{"title":"Inteligência traduzida em <accent>experiência</accent>.","seeComplete":"Ver completo","items":{"macuco-grand-canal":{"description":"O lazer em escala de clube e uma narrativa visual que apresenta cada ambiente antes da obra."},"canvas-altino":{"description":"Da vocação do lugar à narrativa que vende: um lançamento completo, desejado antes de existir."},"the-one-tucuruvi":{"description":"O morar compacto transformado em grandeza, com a cidade inteira dentro do studio."},"livigno":{"description":"Presença grafite, interiores que acolhem e uma elegância sentida antes mesmo da visita."}}},"cta":{"eyebrow":"O PRÓXIMO CASE É O SEU","title":"Seu lançamento no <accent>centro do ecossistema.</accent>","description":"Quatro forças falando a mesma língua, da formatação do produto à experiência que vende — um universo inteiro conspirando a favor da sua próxima grande venda.","button":"Fale com o Grupo Flying"},"detail":{"hero":{"eyebrow":"CASE"},"ficha":{"type":"Tipo","location":"Localização","scope":"Escopo"},"visitLabel":"Conheça a {name}","seeMore":"Ver mais","nextCase":"Próximo case","items":{"macuco-grand-canal":{"heroDescription":"Um lançamento construído em todas as frentes, do conceito do produto ao filme que o apresenta.","statement":"Um mundo inteiro no mesmo <accent>endereço</accent>.","narrative":"O Macuco Grand Canal nasce da generosidade: um produto que reúne lazer, bem-estar e convivência em escala de clube, ambientes desenhados para todas as idades e uma narrativa visual que faz cada espaço ser vivido antes da obra.","ficha":{"type":"Residencial","location":"Santos, SP","scope":"Conceituação, design, visualização, aplicativo e audiovisual"},"services":{"ogdi":"Fez a análise de vocação e o desenvolvimento de conceito do empreendimento.","nid":"Assinou a decoração das áreas comuns, o design de fachada e o PDV do lançamento.","flying":"Produziu as imagens do empreendimento e o aplicativo comercial de vendas.","rinno":"Produziu o Filme Conceito, o Filme Corretor e as pílulas para redes."}},"canvas-altino":{"heroDescription":"Um lançamento construído em todas as frentes, da estratégia do produto à emoção da venda.","statement":"Antes do concreto, o <accent>conceito</accent>.","narrative":"O Canvas Altino nasce do encontro entre estratégia e sensibilidade: um produto concebido a partir da vocação do lugar, um palco de vendas desenhado para encantar e uma narrativa visual que fez o empreendimento ser desejado antes de existir.","ficha":{"type":"Residencial","location":"Presidente Altino | Osasco, SP","scope":"Conceituação, visualização, aplicativo e audiovisual"},"services":{"ogdi":"Fez a análise de vocação e o desenvolvimento de conceito do empreendimento.","nid":"Criou o PDV, o apartamento decorado, as áreas comuns e o design de fachada do lançamento.","flying":"Produziu as imagens do empreendimento e o aplicativo comercial de vendas.","rinno":"Produziu o Filme Conceito, o Filme Produto, o Filme Viral e as pílulas para painel de LED."}},"the-one-tucuruvi":{"heroDescription":"Um lançamento que transforma o morar compacto em grandeza, do desenho do produto à experiência de venda.","statement":"Poucos metros, uma <accent>metrópole</accent>.","narrative":"O The One Tucuruvi nasce da precisão: um produto desenhado para o essencial, uma arquitetura que amplia cada metro e uma narrativa visual que coloca a cidade inteira dentro do studio.","ficha":{"type":"Residencial — studios","location":"Tucuruvi | São Paulo, SP","scope":"Conceituação, visualização, aplicativo e audiovisual"},"services":{"ogdi":"Fez a análise de vocação e o desenvolvimento de conceito do empreendimento.","nid":"Criou o design de fachada e o design de interiores do empreendimento.","flying":"Produziu as imagens do empreendimento e o aplicativo comercial de vendas.","rinno":"Produziu o Filme Produto e o Filme Viral do lançamento."}},"livigno":{"heroDescription":"Um lançamento construído no detalhe, do conceito do produto aos ambientes que acolhem a rotina.","statement":"O desejo mora nos <accent>detalhes</accent>.","narrative":"O Livigno nasce do equilíbrio entre presença e acolhimento: um produto concebido com clareza, ambientes desenhados para receber a vida real e uma experiência visual que faz a elegância ser sentida antes mesmo da visita.","ficha":{"type":"Residencial","location":"São Paulo, SP","scope":"Conceituação, visualização, aplicativo e audiovisual"},"services":{"ogdi":"Fez a análise de vocação e o desenvolvimento de conceito do empreendimento.","nid":"Criou o PDV, os apartamentos decorados, as áreas comuns e o projeto executivo arquitetônico.","flying":"Produziu as imagens do empreendimento e o aplicativo comercial de vendas.","rinno":"Produziu o Filme Conceito, o Filme Produto e o Filme Viral do lançamento."}}}}},"FuturePage":{"eyebrow":"Em breve","description":"Esta página ainda está em construção, mas já foi preparada na navegação para apoiar a expansão do site."}},"now":"$undefined","timeZone":"America/Sao_Paulo","children":"$L21"}]
