# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
.claude
/.claude
.claude/
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — o build (.next) É versionado para o deploy no cPanel (Napoleon):
# sobe pronto, no servidor só se roda npm install + start (server.js).
# O cache do webpack fica de fora: pesado (~230 MB) e inútil no deploy.
# O dev usa .next-dev (ver next.config.mjs) para NUNCA sujar o build.
/.next/cache/
/.next-dev/
/out/

# versões web do acervo geradas por scripts/gerar-acervo-web.mjs
# (vão para o servidor de imagens, não para o repositório)
/acervo-web/

# vídeos brutos de demonstração (~200 MB cada) — o site usa as versões
# web comprimidas (exemplo-aplicativo.mp4 / exemplo-dsbrave.mp4)
/public/tour/Exemplo_*.mp4

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
